# API environment variables (Req 14.2). Copy to `.env` and fill in real values.
# Never commit the real `.env` file (see repo .gitignore, Req 23.3).

# PostgreSQL connection string. Local example (Docker Compose added in task 2.1):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"

# HTTP server port
PORT=4000

# Comma-separated list of allowed CORS origins (deployed frontend + localhost)
ALLOWED_ORIGINS="http://localhost:3000"

# AWS credentials / config (used for S3 + Cognito later)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
