# API environment variables. Copy to `.env` and fill in real values.
# This file is committed; the real `.env` is gitignored. Never commit secrets.

# ----------------------------------------------------------------
# DATABASE (required)
# ----------------------------------------------------------------
# Local: postgres://postgres:postgres@127.0.0.1:5433/inventory?schema=public
# Production: get from Neon/Supabase dashboard (looks like:
#   postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&schema=public)
DATABASE_URL=""

# ----------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------
PORT=4000                        # Render sets this to 10000 automatically
ALLOWED_ORIGINS="http://localhost:3000"  # production: your Vercel URL

# ----------------------------------------------------------------
# AWS (for S3 image uploads; can leave placeholder locally if not using images)
# ----------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""             # IAM user access key
AWS_SECRET_ACCESS_KEY=""         # IAM user secret
S3_BUCKET=""                     # your S3 bucket name

# ----------------------------------------------------------------
# COGNITO (for production JWT auth; use AUTH_MODE=dev locally)
# ----------------------------------------------------------------
COGNITO_USER_POOL_ID=""          # from Cognito console: us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=""             # Cognito app client id

# ----------------------------------------------------------------
# AUTH MODE
# ----------------------------------------------------------------
# "dev"     - local email/password login (no Cognito required)
# "cognito" - production: verifies real Cognito JWTs
AUTH_MODE="dev"